{
  "realm": "mariposa",
  "displayName": "Grupo Mariposa",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 30,
  "maxFailureWaitSeconds": 300,
  "quickLoginCheckMilliSeconds": 100,
  "minimumQuickLoginWaitSeconds": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "orders-reader",
        "description": "Read processed orders"
      },
      {
        "name": "orders-admin",
        "description": "Operate the orders platform"
      },
      {
        "name": "products-reader",
        "description": "Read the product catalog"
      },
      {
        "name": "clients-reader",
        "description": "Read the client master data"
      }
    ]
  },
  "clients": [
    {
      "clientId": "order-processor",
      "name": "order-processor service",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ORDER_PROCESSOR_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience-products-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "products-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-clients-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "clients-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "order-tracker",
      "name": "Order tracker PWA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8090/",
        "http://localhost:8080/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:8090",
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8090/"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience-order-processor",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "order-processor",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "orders-cli",
      "name": "Local tooling (curl, Karate)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "access.token.lifespan": "900"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience-order-processor",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "order-processor",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-products-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "products-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-clients-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "clients-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-order-processor",
      "enabled": true,
      "serviceAccountClientId": "order-processor",
      "realmRoles": [
        "products-reader",
        "clients-reader"
      ]
    },
    {
      "username": "analyst",
      "firstName": "Ana",
      "lastName": "Analista",
      "email": "analyst@grupomariposa.dev",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "orders-reader"
      ]
    },
    {
      "username": "admin",
      "firstName": "Olga",
      "lastName": "Operaciones",
      "email": "admin@grupomariposa.dev",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "orders-reader",
        "orders-admin",
        "products-reader",
        "clients-reader"
      ]
    },
    {
      "username": "viewer",
      "firstName": "Sin",
      "lastName": "Permisos",
      "email": "viewer@grupomariposa.dev",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": []
    }
  ]
}
