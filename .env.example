# Copia generada por ./mariposa.sh init (o .\mariposa.ps1 init) con valores aleatorios.
# Nunca subas el archivo .env al repositorio. En CI/CD estos valores vienen de GitHub Secrets.

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=order_processor
MONGO_APP_PASSWORD=
REDIS_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=kcadmin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PUBLIC_URL=http://localhost:8180
ORDER_PROCESSOR_CLIENT_SECRET=
DEMO_USER_PASSWORD=
PII_ENCRYPTION_KEY=
CONFIG_SERVER_USERNAME=config-reader
CONFIG_SERVER_PASSWORD=
GRAFANA_ADMIN_USERNAME=admin
GRAFANA_ADMIN_PASSWORD=

# Opcional: perfil datadog (docker compose --profile datadog up)
DATADOG_ENABLED=false
DD_API_KEY=
DD_SITE=datadoghq.com
