{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.grupomariposa.dev/events/orders.created.v1.schema.json",
  "title": "OrderCreated v1",
  "description": "Topic orders.created.v1, key = orderId. Owner: orders intake team. Unknown fields are ignored by consumers (tolerant reader).",
  "type": "object",
  "required": ["eventId", "orderId", "market", "currency", "clientId", "items"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "eventVersion": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Revision of the order. A higher value supersedes a lower one."
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "orderId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "market": { "type": "string", "enum": ["MX", "CO", "PE"] },
    "currency": { "type": "string", "enum": ["MXN", "COP", "PEN"] },
    "clientId": {
      "type": "string",
      "pattern": "^CLI-[A-Z0-9]{1,20}$",
      "description": "Same format as clients-api GET /clients/{clientId}."
    },
    "channel": { "type": "string", "maxLength": 32 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["productId", "quantity", "unitPrice"],
        "properties": {
          "productId": {
            "type": "string",
            "pattern": "^PRD-[A-Z0-9]{1,20}$",
            "description": "Same format as products-api GET /products/{productId}."
          },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPrice": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "$comment": "Business rules outside JSON Schema: productId must be unique within items; currency must match market (MX-MXN, CO-COP, PE-PEN). order-processor enforces this schema, including the productId and clientId patterns, and routes violations to orders.processing.dlt with x-error-category=VALIDATION."
}
