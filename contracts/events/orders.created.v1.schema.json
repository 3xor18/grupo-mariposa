{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.grupomariposa.dev/events/orders.created.v1.schema.json",
  "title": "OrderCreated v1",
  "description": "Topic orders.created.v1, key = orderId. Owner: orders intake team. Unknown fields are ignored by consumers (tolerant reader).",
  "type": "object",
  "required": ["eventId", "orderId", "market", "currency", "clientId", "items"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "eventVersion": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Revision of the order. A higher value supersedes a lower one."
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "orderId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "market": { "type": "string", "enum": ["MX", "CO", "PE"] },
    "currency": { "type": "string", "enum": ["MXN", "COP", "PEN"] },
    "clientId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "channel": { "type": "string", "maxLength": 32 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["productId", "quantity", "unitPrice"],
        "properties": {
          "productId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPrice": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "x-business-rules": [
    "productId must be unique within items",
    "currency must match market: MX-MXN, CO-COP, PE-PEN"
  ]
}
